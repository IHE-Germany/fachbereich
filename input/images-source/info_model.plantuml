@startuml

abstract class "Org" as org

org .left. org

abstract class "administrativ" as adm

abstract class "klinisch" as klin {
    typ
}

class "Fachabteilung" as fabt #cfc

class "Verwaltung" as verw
class "Technik" as technik
class "Lager" as lager
class "Apotheke" as apo
class "Küche" as kueche

org <|-- adm
org <|-- klin
org <|-- einr
klin <|-- fabt
adm <|-- verw
adm <|-- technik
adm <|-- lager
lager <|-- apo
adm <|-- kueche

class "Einrichtung" as einr {
    IK-Nummer
    name
}

class "Standort" as ort {
    id
    adresse
    gps
}

einr -left- ort : > hat Standort

class "Fachbereich" as fachb #cfc

fabt -right- "1..*" fachb : Zuordnung >

class "Disziplin" as disz

fachb "1..*" .. "1" disz

@enduml